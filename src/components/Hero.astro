---
import { Image } from "astro:assets";
import GitHubProfile from "../assets/images/github-profile.webp";
import LinkedIn from "../assets/icons/linkedin.svg";
import GitHub from "../assets/icons/github.svg";
import DocumentIcon from "../assets/icons/documentIcon.svg";
---

<section class="flex flex-col items-center w-full max-h-screen mt-28 py-10 jus">
    <div class="flex flex-row gap-x-5 w-full items-center">
        <Image
            class="rounded-full size-20 opacity-60"
            src={GitHubProfile}
            alt="Foto de Perfil 2X2 Jhossua Roa Rodriguez"
            fetchpriority={"high"}
            loading={"eager"}
        />
        <div class="md:w-full min-w-[250px]">
            <a
                href="https://www.linkedin.com/in/jhossuarodriguez/"
                rel="nooperer noreferrer"
                target="_blank"
                class="border border-secondary py-1 md:py-2 px-1 md:px-2 rounded-full hover:border-secondary hover:bg-secondary hover:text-white transform duration-200 text-base md:text-base"
                >Disponible para Trabajar</a
            >
        </div>
    </div>
    <div class="flex flex-col w-full mt-10">
        <h1 class="text-xl md:text-2xl">
            Hey, me llamo <span class="text-3xl font-bold">Jhossua</span>
        </h1>
        <p class="w-full md:w-[70%] mt-5 text-sm md:text-xl leading-[1.6]">
            Desarrollador junior con una pasión por la creación de experiencias
            web excepcionales. En este portafolio podrás conocer más sobre mis
            proyectos y las tecnologías que utilizo.
        </p>
        <div
            class="flex flex-wrap flex-1/2 md:flex-row gap-3 mt-10 min-w-[250px] md-w-full"
        >
            <a
                class="w-24 py-2 px-4 md:py-2 md:px-2 text-xs md:text-base flex flex-row justify-center items-center gap-1 border border-primary rounded-xl hover:text-primary hover:bg-secondary transition duration-300"
                href="https://github.com/jhossuarodriguez/lorar-website"
                rel="nooperer noreferer"
                target="_blank"
            >
                Github<GitHub class="size-4 md:size-6" />
            </a>
            <a
                class="py-2 px-4 md:py-2 md:px-2 text-xs md:text-base flex flex-row justify-center items-center gap-1 border border-primary rounded-xl hover:text-primary hover:bg-secondary transition duration-300"
                href="https://www.linkedin.com/in/jhossuarodriguez/"
                rel="nooperer noreferer"
                target="_blank"
            >
                LinkedIn<LinkedIn class="size-4 md:size-6" />
            </a>
            <a
                href="../assets/CV/CV_Jhossua_Roa_Rodriguez.pdf"
                class="py-2 px-4 md:py-2 md:px-2 text-xs md:text-base flex flex-row justify-center items-center gap-1 border border-primary rounded-xl hover:text-primary hover:bg-secondary transition duration-300 w-24 cursor-pointer"
                download="CV_Jhossua_Roa_Rodriguez.pdf"
                rel="nooperer noreferer"
            >
                CV<DocumentIcon class="size-4 md:size-6" />
            </a>
        </div>
    </div>
</section>
