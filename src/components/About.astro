---
import ProfileIcon from "../assets/icons/profile.svg";
import { Image } from "astro:assets";
import ProfilePicture from "../assets/images/profile-picture.webp";
---

<section class="flex flex-col mt-10 md:mt-44 w-full h-full py-10" id="about">
    <div class="flex flex-row gap-3">
        <ProfileIcon class="size-10 text-primary opacity-65" />
        <h1 class="text-3xl font-bold">Sobre Mí</h1>
    </div>
    <div class="flex flex-row mt-10 gap-16">
        <Image
            src={ProfilePicture}
            alt="Foto de Perfil Jhossua"
            class="size-40 rounded hover:-rotate-3 opacity-60 hover:opacity-100 transition duration-500 shadow-2xl"
        />
        <p class="w-[70%] text-sm md:text-xl leading-[1.6]">
            Mi nombre es Jhossua Roa Rodriguez, vivo en Santo Domingo, Republica
            Dominicana, soy estudiante del Instituto Tecnologico de Santo
            Domingo (ITLA) en la carrera de desarrollador de Software.
        </p>
    </div>
</section>
