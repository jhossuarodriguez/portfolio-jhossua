---
import DevIcon from "../assets/icons/dev.svg";
import { Image } from "astro:assets";
import Project1 from "../assets/images/project1.webp";
import Project2 from "../assets/images/project2.webp";
import AstroLogo from "../assets/icons/astro.svg";
import TailwindLogo from "../assets/icons/tailwind.svg";
import GitHub from "../assets/icons/github.svg";
import FigmaLogo from "../assets/icons/figma.svg";
---

<section class="flex flex-col w-full mt-44 py-5 min-h-full" id="projects">
    <div class="flex flex-row gap-3">
        <DevIcon class="size-10 text-primary" />
        <h1 class="text-3xl text-primary font-bold">Proyectos</h1>
    </div>

    <!--First Project -->
    <div class="flex flex-row gap-20 mt-10 items-center">
        <Image
            class="w-[450px] h-full object-contain rounded-lg shadow-2xl hover:scale-110 transition-transform duration-700"
            src={Project1}
            alt="Proyecto Lorar Studio - Pagina de arquitectura hecha con Astro, tailwind y javascript"
            fetchpriority={"high"}
            loading={"lazy"}
        />

        <div class="flex flex-col">
            <h2 class="text-3xl font-bold">
                Lorar Studio - Pagina Arquitectura
            </h2>
            <div class="flex flex-row mt-5 gap-3">
                <a
                    href="https://astro.build/"
                    rel="noopener noreferrer"
                    target="_blank"
                    class="flex flex-row justify-center items-center text-primary rounded-full border border-primary px-5 gap-3 bg-gradient-to-tr from-[#1321AC] to-[#881ABD] text-sm hover:scale-105 transition-transform duration-500"
                    ><AstroLogo class="size-4" /> Astro</a
                >
                <a
                    href="https://tailwindcss.com/"
                    rel="noopener noreferrer"
                    target="_blank"
                    class="flex flex-row justify-center items-center text-primary rounded-full border border-primary px-3 gap-3 text-sm hover:scale-105 transition-transform duration-500 bg-[#00315]"
                    ><TailwindLogo class="size-4" /> Tailwind CSS</a
                >
            </div>
            <div class="flex flex-col mt-7">
                <p class="text-primary text-base leading-[1.6]">
                    Lorar Studio es un sitio web de arquitectura desarrollado
                    con Astro, Tailwind CSS y JavaScript, diseñado para ofrecer
                    una experiencia rápida, optimizada y visualmente atractiva a
                    sus clientes para brindar el mejor servicio.
                </p>
            </div>
            <div class="flex flex-row mt-5 gap-5">
                <a
                    class="py-2 px-2 flex flex-row justify-center items-center gap-1 border border-primary rounded-xl hover:text-primary hover:bg-secondary transition duration-300"
                    href="https://github.com/jhossuarodriguez/lorar-website"
                    rel="nooperer noreferer"
                    target="_blank"
                >
                    GitHub<GitHub class="size-6 text-primary" />
                </a>
                <a
                    class="py-2 px-2 flex flex-row justify-center items-center gap-2 border border-primary rounded-xl hover:text-primary hover:bg-secondary transition duration-300"
                    rel="nooperer noreferer"
                    href="https://www.figma.com/proto/pr9PEnwmmsrAAyy9IhEry9/Lorart-Studio?node-id=0-1&t=bM1VGAwEpcrAnZBf-1"
                    target="_blank"
                >
                    Figma<FigmaLogo class="size-6 text-primary" />
                </a>
            </div>
        </div>
    </div>

    <!--Second Project -->
    <div class="flex flex-row gap-20 mt-10 items-center">
        <Image
            class="w-[450px] h-full object-contain rounded-lg shadow-2xl hover:scale-110 transition-transform duration-700"
            src={Project2}
            alt="Proyecto Lorar Studio - Pagina de arquitectura hecha con Astro, tailwind y javascript"
            fetchpriority={"high"}
            loading={"lazy"}
        />

        <div class="flex flex-col">
            <h2 class="text-3xl font-bold">
                Tenax Construction - Constructora Dominicana
            </h2>
            <div class="flex flex-row mt-5 gap-3">
                <a
                    href="https://astro.build/"
                    rel="noopener noreferrer"
                    class="flex flex-row justify-center items-center text-primary rounded-full border border-primary px-5 gap-3 bg-gradient-to-tr from-[#1321AC] to-[#881ABD] text-sm hover:scale-105 transition-transform duration-500"
                    ><AstroLogo class="size-4" /> Astro</a
                >
                <a
                    href="https://tailwindcss.com/"
                    rel="noopener noreferrer"
                    class="flex flex-row justify-center items-center text-primary rounded-full border border-primary px-3 gap-3 text-sm hover:scale-105 transition-transform duration-500 bg-[#00315]"
                    ><TailwindLogo class="size-4" /> Tailwind CSS</a
                >
            </div>
            <div class="flex flex-col mt-7">
                <p class="text-primary text-base leading-[1.6]">
                    Lorar Studio es un sitio web de arquitectura desarrollado
                    con Astro, Tailwind CSS y JavaScript, diseñado para ofrecer
                    una experiencia rápida, optimizada y visualmente atractiva a
                    sus clientes para brindar el mejor servicio.
                </p>
            </div>
            <div class="flex flex-row mt-5 gap-5">
                <a
                    class="py-2 px-2 flex flex-row justify-center items-center gap-1 border border-primary rounded-xl hover:text-primary hover:bg-secondary transition duration-300"
                    href="https://github.com/jhossuarodriguez/tenax-website"
                    rel="nooperer noreferer"
                >
                    GitHub<GitHub class="size-6 text-primary" />
                </a>
                <a
                    class="py-2 px-2 flex flex-row justify-center items-center gap-2 border border-primary rounded-xl hover:text-primary hover:bg-secondary transition duration-300"
                    rel="nooperer noreferer"
                    href="https://www.figma.com/proto/UP7UvUiGncYdC0CAxvaTi0/Tenax-Construction?node-id=0-1&t=M1pC73gxaM8Mhj7d-1"
                >
                    Figma<FigmaLogo class="size-6" />
                </a>
            </div>
        </div>
    </div>
</section>
