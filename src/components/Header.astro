---
import DarkMode from "../assets/icons/sun.svg";
---

<header class="fixed top-0 flex justify-center py-5 w-full mx-auto z-[99999px]">
    <nav
        class="flex justify-center items-center py-2 px-10 border border-transparent h-full rounded-full bg-[#334054] z-50"
    >
        <ul class="flex justify-center gap-x-5 items-center">
            <li>
                <a
                    class="hover:text-secondary transition duration-200"
                    href="#projects">Projects</a
                >
            </li>
            <li>
                <a
                    class="hover:text-secondary transition duration-200"
                    href="#about">About</a
                >
            </li>
            <li>
                <a
                    class="hover:text-secondary transition duration-200"
                    href="mailto:jhossuarodriguezz@gmail.com"
                    aria-label="contacto">Contacto</a
                >
            </li>
            <li>
                <button
                    type="button"
                    class="flex justify-center items-center cursor-pointer"
                    id="theme-toggle-btn"
                    aria-label="Modo Oscuro"
                    title="Mostrar Modo Oscuro"
                >
                    <DarkMode
                        class="flex justify-center items-center size-5 hover:text-secondary transition duration-200"
                    />
                </button>
            </li>
        </ul>
    </nav>
</header>

<style>
    nav {
        background: transparent;
        animation: header-blur-scroll 0.3s linear both;
        animation-timeline: scroll();
        animation-range: 0 200px;
    }

    @keyframes header-blur-scroll {
        0% {
            backdrop-filter: blur(0px);
            background: transparent;
        }

        100% {
            backdrop-filter: blur(10px);
            box-shadow: 0px 0px 5px 0px;
        }
    }
</style>
