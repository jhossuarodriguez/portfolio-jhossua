---
import LightMode from "../assets/icons/sun.svg";
import DarkMode from "../assets/icons/moon.svg";

const THEME = ["light", "dark"];
---

<header class="fixed top-0 flex justify-center py-5 w-full mx-auto z-[99999px]">
    <nav
        class="flex justify-center items-center py-2 px-10 border border-transparent h-full rounded-full bg-[#334054] z-50"
    >
        <ul class="flex justify-center gap-x-5 items-center">
            <li>
                <a
                    class="hover:text-white dark:hover:text-secondary transition duration-200"
                    href="#projects">Projects</a
                >
            </li>
            <li>
                <a
                    class="hover:text-white dark:hover:text-secondary transition duration-200"
                    href="#about">About</a
                >
            </li>
            <li>
                <a
                    class="hover:text-white dark:hover:text-secondary transition duration-200"
                    href="mailto:jhossuarodriguezz@gmail.com"
                    aria-label="contacto">Contacto</a
                >
            </li>
            <li>
                <button
                    type="button"
                    class="flex justify-center appearance-none border-none items-center cursor-pointer hover:scale-110 transition"
                    id="theme-toggle-btn"
                    aria-label="Modo Oscuro"
                    title="Mostrar Modo Oscuro"
                >
                    <LightMode
                        class="size-5 transition-all duration-200"
                        id="light"
                    />
                    <DarkMode
                        class="size-5 transition-all duration-200"
                        id="dark"
                    />
                </button>
            </li>
        </ul>
    </nav>
</header>

<style>
    nav {
        background: transparent;
        animation: header-blur-scroll 0.3s linear both;
        animation-timeline: scroll();
        animation-range: 0 200px;
    }

    @keyframes header-blur-scroll {
        0% {
            backdrop-filter: blur(0px);
            background: transparent;
        }

        100% {
            backdrop-filter: blur(10px);
            box-shadow: 0px 0px 5px 0px;
        }
    }
</style>
<script is:inline>
    const themeToggleBtn = document.getElementById("theme-toggle-btn");
    const lightIcon = document.getElementById("light");
    const darkIcon = document.getElementById("dark");

    // Configuración de temas
    const THEMES = ["light", "dark"];

    const getPreference = () => {
        if (typeof localStorage !== "undefined") {
            return localStorage.getItem("theme") ?? "system";
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
    };

    // Función para actualizar los iconos según el tema
    const updateIcons = (theme) => {
        const isLight = theme === "light";
        lightIcon.style.display = isLight ? "block" : "none";
        darkIcon.style.display = isLight ? "none" : "block";
    };

    // Función para aplicar el tema
    const applyTheme = (theme) => {
        document.documentElement.setAttribute("data-theme", theme);
        localStorage.setItem("theme", theme);
        updateIcons(theme);
    };

    // Inicialización del tema
    const savedTheme = localStorage.getItem("theme");
    const initialTheme = THEMES.includes(savedTheme) ? savedTheme : "light";
    let currentThemeIndex = THEMES.indexOf(initialTheme);

    // Aplicar el tema inicial
    applyTheme(initialTheme);

    // Manejador del evento clic para cambiar el tema
    themeToggleBtn.addEventListener("click", () => {
        currentThemeIndex = (currentThemeIndex + 1) % THEMES.length;
        applyTheme(THEMES[currentThemeIndex]);
    });
</script>
