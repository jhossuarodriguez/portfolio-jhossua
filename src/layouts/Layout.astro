---
import "../styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "@fontsource/poppins/300.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import ArrowUp from "../assets/icons/arrowUp.svg";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Portfolio de Jhossua, desarrollador con pasión por la creación de experiencias web excepcionales. En este portafolio podrás conocer más sobre mis proyectos y las tecnologías que utilizo"
		/>
		<meta name="og:image" content="/og-image.webp" />
		<meta name="og:title" content="Portfolio - Jhossua Roa Rodriguez" />
		<meta
			name="og:description"
			content="Desarrollador con pasión por la creación de experiencias web excepcionales. En este portafolio podrás conocer más sobre mis proyectos y las tecnologías que utilizo"
		/>
		<meta name="author" content="Jhossua Roa Rodriguez" />
		<meta name="theme-color" content="#374057" />
		<title>Portfolio - Jhossua Roa Rodriguez</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<SpeedInsights />
	</head>
	<body class="absolute" id="home">
		<Header />
		<div
			class="w-full max-w-7xl px-4 sm:px-8 md:px-16 lg:px-32 xl:px-40 mx-auto"
		>
			<slot />
			<Footer />
		</div>

		<section class="fixed bottom-12 right-12" id="scroll-to-top">
			<a href="#home" aria-labelledby="Up" aria-label="Subir">
				<ArrowUp class="size-12" />
			</a>
		</section>
	</body>
</html>

<style>
	:root {
		color-scheme: light dark;
	}
	html,
	body {
		scroll-behavior: smooth;
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: "Poppins", sans-serif;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}

	@media (prefers-color-scheme: dark) {
		html {
			background: linear-gradient(to right, #475569, #1e2a47);
			color: #f4f4fdb7;
		}
	}
	@media (prefers-color-scheme: light) {
		html {
			background: linear-gradient(to right, #f8fafc, #9ca3af);
			color: #1f2937c9;
		}
	}

	#scroll-to-top {
		animation: scroll-to-top 0.3s both;
		animation-timeline: scroll();
		animation-range: 0 500px;
	}
	@supports (animation-timeline: scroll()) {
		@keyframes scroll-to-top {
			0% {
				opacity: 0;
				pointer-events: none;
			}

			20% {
				opacity: 0.5;
				pointer-events: none;
			}

			100% {
				opacity: 1;
				pointer-events: auto;
			}
		}
	}
</style>
