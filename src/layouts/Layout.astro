---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "@fontsource/poppins/300.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import ArrowUp from "../assets/icons/arrowUp.svg";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Portfolio de Jhossua, desarrollador junior con una pasión por la creación de experiencias web excepcionales. En este portafolio podrás conocer más sobre mis proyectos y las tecnologías que utilizo"
		/>
		<meta name="robots" content="index, follow" />
		<meta name="author" content="Jhossua Roa Rodriguez" />
		<meta name="theme-color" content="#1e2a47" />
		<title>Portfolio Dev - Jhossua Roa Rodriguez</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	</head>
	<body class="absolute" id="home">
		<Header />
		<div
			class="w-full max-w-7xl px-4 sm:px-8 md:px-16 lg:px-32 xl:px-40 mx-auto"
		>
			<slot />
			<Footer />
		</div>
		<div class="fixed bottom-12 right-12">
			<a href="#home" aria-labelledby="Up" aria-label="Subir">
				<ArrowUp class="size-12" />
			</a>
		</div>
	</body>

	<style>
		:root {
			color-scheme: light dark;
		}
		html,
		body {
			scroll-behavior: smooth;
			background: linear-gradient(to right, #475569, #1e2a47);
			margin: 0;
			width: 100%;
			height: 100%;
			color: #f4f4fdb7;
			font-family: "Poppins", sans-serif;
		}
		@media (prefers-reduced-motion: reduce) {
			html {
				scroll-behavior: auto;
			}
		}
	</style>
</html>
